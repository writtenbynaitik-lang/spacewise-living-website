---
/**
 * RelatedRooms — "Explore another room" at the foot of a category page.
 *
 * Reuses the homepage `.explore-card` language rather than introducing a second
 * category-card style: a reader who met these cards on the homepage should
 * recognise them here. The only difference is the grid — three across instead
 * of four, because three related rooms are shown, not eight.
 *
 * Destinations come from `related` in `categories.ts` and are resolved through
 * `relatedCategories()`, which throws on an unknown slug. A dead room card
 * therefore fails the build rather than shipping.
 */
import { Picture } from 'astro:assets';
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import type { Category } from '../../config/categories';

interface Props {
  categories: Category[];
  eyebrow?: string;
  heading?: string;
}

const {
  categories,
  eyebrow = 'Keep exploring',
  heading = 'Explore another room',
} = Astro.props;

/** Three-up at desktop, two-up at tablet, full column on a phone. */
const CARD_SIZES = '(min-width: 64rem) 360px, (min-width: 48rem) 45vw, 92vw';
const CARD_WIDTHS = [280, 400, 560, 800];
---

<Section aria-labelledby="related-rooms-heading">
  <Container width="content">
    <header class="section-head">
      <Eyebrow class="section-head__eyebrow">{eyebrow}</Eyebrow>
      <h2 class="t-h2 section-head__heading" id="related-rooms-heading">{heading}</h2>
    </header>

    <ul class="related-rooms">
      {
        categories.map((category) => (
          <li>
            <article class="explore-card">
              <div class="explore-card__media">
                {category.image ? (
                  <div class="frame explore-card__frame">
                    <Picture
                      src={category.image.src}
                      alt={category.image.alt}
                      widths={CARD_WIDTHS}
                      sizes={CARD_SIZES}
                      formats={['avif', 'webp']}
                      fallbackFormat="jpeg"
                      loading="lazy"
                      decoding="async"
                      onerror="this.closest('.frame')?.setAttribute('data-media-failed','true')"
                    />
                  </div>
                ) : (
                  <div class="frame explore-card__frame" aria-hidden="true" />
                )}
              </div>

              <h3 class="explore-card__title">
                {/* Stretched link — the title is the link's accessible name. */}
                <a class="explore-card__link" href={`/${category.slug}/`}>
                  {category.name}
                </a>
              </h3>

              <p class="explore-card__description">{category.cardDescription}</p>

              <span class="explore-card__indicator">
                <svg viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
                  <path
                    d="M2.5 8h11m0 0L9 3.5M13.5 8 9 12.5"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
            </article>
          </li>
        ))
      }
    </ul>
  </Container>
</Section>
