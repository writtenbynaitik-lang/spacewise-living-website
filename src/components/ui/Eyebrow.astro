---
/**
 * Eyebrow - small editorial label above a heading.
 *
 * It orients the reader and must never compete with the headline. Use the
 * accent tone for at most one eyebrow per view; if every label is accented,
 * the accent stops carrying meaning.
 */
interface Props {
  tone?: 'muted' | 'accent' | 'ink';
  /** Prefix the label with a short accent rule, for feature sections. */
  marked?: boolean;
  as?: 'p' | 'span' | 'div';
  class?: string;
}

const { tone = 'muted', marked = false, as: Tag = 'p', class: className } = Astro.props;
---

<Tag
  class:list={[
    'eyebrow',
    tone === 'accent' && 'eyebrow--accent',
    tone === 'ink' && 'eyebrow--ink',
    marked && 'eyebrow--marked',
    className,
  ]}
>
  <slot />
</Tag>
