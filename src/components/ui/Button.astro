---
/**
 * Button - primary, secondary and text variants.
 *
 * Renders an <a> when `href` is given and a <button> otherwise, so the element
 * always matches the behaviour: links navigate, buttons act.
 *
 * Every variant carries a non-colour cue for its states (background change,
 * border change, underline, or a 1px press offset), because state must never be
 * communicated by hue alone.
 *
 * The labels this will eventually carry ("Read article", "View all ideas",
 * etc.) are passed in by the caller. None are baked in here - they are content
 * decisions, not design-system facts.
 */
interface Props {
  variant?: 'primary' | 'secondary' | 'text';
  size?: 'sm' | 'base' | 'lg';
  /** Renders an <a>. Omit for a <button>. */
  href?: string;
  /** Button type. Ignored when `href` is set. */
  type?: 'button' | 'submit';
  disabled?: boolean;
  full?: boolean;
  /** Show the sliding arrow affordance (text and secondary variants). */
  arrow?: boolean;
  /** Accessible name when the visible label is not descriptive enough. */
  ariaLabel?: string;
  class?: string;
}

const {
  variant = 'primary',
  size = 'base',
  href,
  type = 'button',
  disabled = false,
  full = false,
  arrow = false,
  ariaLabel,
  class: className,
} = Astro.props;

const classes = [
  'button',
  `button--${variant}`,
  size !== 'base' && `button--${size}`,
  full && 'button--full',
  className,
];

/** A disabled link is not a real thing: drop the href and mark it for AT. */
const isDisabledLink = Boolean(href) && disabled;
---

{
  href ? (
    <a
      class:list={classes}
      href={isDisabledLink ? undefined : href}
      role={isDisabledLink ? 'link' : undefined}
      aria-disabled={disabled ? 'true' : undefined}
      aria-label={ariaLabel}
    >
      <slot />
      {arrow && (
        <svg class="button__arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
          <path d="M2.5 8h11m0 0L9 3.5M13.5 8 9 12.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      )}
    </a>
  ) : (
    <button class:list={classes} type={type} disabled={disabled} aria-label={ariaLabel}>
      <slot />
      {arrow && (
        <svg class="button__arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
          <path d="M2.5 8h11m0 0L9 3.5M13.5 8 9 12.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      )}
    </button>
  )
}
