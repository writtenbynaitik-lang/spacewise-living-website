---
/**
 * Container - horizontal width + gutter.
 *
 * Width is a deliberate choice per context. `article` is the reading column and
 * is much narrower than `content` on purpose: that difference is what makes
 * reading feel distinct from browsing.
 */
interface Props {
  width?: 'max' | 'wide' | 'content' | 'article' | 'narrow';
  /** Element to render. Use a landmark element where one is appropriate. */
  as?: 'div' | 'section' | 'article' | 'header' | 'footer' | 'nav' | 'aside';
  class?: string;
}

const { width = 'content', as: Tag = 'div', class: className } = Astro.props;
---

<Tag class:list={['container', `container--${width}`, className]}>
  <slot />
</Tag>
